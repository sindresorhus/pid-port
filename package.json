{
	"name": "pid-port",
	"version": "2.2.0",
	"description": "Get the ID of the process that uses a certain port",
	"license": "MIT",
	"repository": "sindresorhus/pid-port",
	"funding": "https://github.com/sponsors/sindresorhus",
	"type": "module",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "xo && node --test test.js && tsc"
	},
	"files": [
		"index.js",
		"index.d.ts"
	],
	"keywords": [
		"pid",
		"port",
		"ports",
		"netstat",
		"process",
		"processes",
		"id",
		"convert",
		"converter"
	],
	"dependencies": {
		"execa": "^9.6.0"
	},
	"devDependencies": {
		"get-port": "^7.2.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"xo": [
		{
			"files": [
				"test.js"
			],
			"rules": {
				"node-test/prefer-test-context-assert": "off",
				"node-test/no-conditional-assertion": "off",
				"node-test/no-process-env-mutation": "off"
			}
		}
	]
}
